########################################################################
# Mountain-Able API — manual test collection (VS Code "REST Client")
# ---------------------------------------------------------------------
# 1. Start MongoDB, then: npm run seed && npm run dev
# 2. Install the "REST Client" extension (humao.rest-client)
# 3. Run the four "LOGIN" requests first (top to bottom) so the tokens
#    are captured, then click "Send Request" on any endpoint below.
# All seeded accounts share the password: Password123!
########################################################################

@baseUrl = http://localhost:5000/api
@password = Password123!

### ---------------------------------------------------------------- AUTH

# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "admin@mountainable.it", "password": "{{password}}" }

###
# @name loginOfficer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "officer.aosta@mountainable.it", "password": "{{password}}" }

###
# @name loginTourist
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "sara@example.com", "password": "{{password}}" }

###
# @name loginAuthority
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "authority@mountainable.it", "password": "{{password}}" }

###
@adminToken = {{loginAdmin.response.body.data.token}}
@officerToken = {{loginOfficer.response.body.data.token}}
@touristToken = {{loginTourist.response.body.data.token}}
@authorityToken = {{loginAuthority.response.body.data.token}}

### Register a new tourist
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "firstName": "New", "lastName": "Tourist", "email": "new.tourist@example.com", "password": "{{password}}", "city": "Torino" }

### Current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{touristToken}}

### Update own profile (JSON — text fields)
PATCH {{baseUrl}}/auth/me
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "city": "Milano", "phone": "+39 340 0000000" }

### Upload own avatar (multipart — adjust the file path to a real image on disk)
PATCH {{baseUrl}}/auth/me
Authorization: Bearer {{touristToken}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./uploads/.gitkeep
------boundary--

### Health
GET {{baseUrl}}/health

### ----------------------------------------------------------- VILLAGES

### List (default sort -rating, page 1, limit 9)
GET {{baseUrl}}/villages

### List with search + filters + sort + pagination
GET {{baseUrl}}/villages?search=lake&minRating=3&sort=name&page=1&limit=5

### Filter by region / province
GET {{baseUrl}}/villages?region=Abruzzo

### Filter by category (villages with an attraction in this category)
GET {{baseUrl}}/villages?category=hiking

### Admin: include unpublished villages
GET {{baseUrl}}/villages?includeUnpublished=true
Authorization: Bearer {{adminToken}}

### Map payload (lightweight)
GET {{baseUrl}}/villages/map

### Map payload, filtered — must return the same set as the list below
GET {{baseUrl}}/villages/map?region=Abruzzo&minRating=4

### …the matching list request, for comparison
GET {{baseUrl}}/villages?region=Abruzzo&minRating=4&limit=50

### Map payload, filter matching nothing — expect data: []
GET {{baseUrl}}/villages/map?region=Abruzzo&minRating=5

### Detail by slug
# @name villageDetail
GET {{baseUrl}}/villages/scanno

###
@villageId = {{villageDetail.response.body.data._id}}

### Create village (officer → own municipality)
# @name createVillage
POST {{baseUrl}}/villages
Authorization: Bearer {{officerToken}}
Content-Type: application/json

{
  "name": "Test Borgo Alpino",
  "description": "A small test village high in the Aosta Valley, created via the API test file.",
  "shortDescription": "A test village.",
  "region": "Aosta Valley",
  "province": "Aosta",
  "location": { "lat": 45.72, "lng": 7.61 },
  "altitude": 1500,
  "population": 120
}

###
@newVillageId = {{createVillage.response.body.data._id}}

### Update village (owning officer)
PATCH {{baseUrl}}/villages/{{newVillageId}}
Authorization: Bearer {{officerToken}}
Content-Type: application/json

{ "population": 150, "shortDescription": "Updated description." }

### Publish village (admin only)
PATCH {{baseUrl}}/villages/{{newVillageId}}/publish
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "isPublished": true }

### Upload images (multipart; adjust the file path to a real image on disk)
POST {{baseUrl}}/villages/{{newVillageId}}/images
Authorization: Bearer {{officerToken}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="images"; filename="photo.png"
Content-Type: image/png

< ./uploads/.gitkeep
------boundary--

### Delete an image by index
DELETE {{baseUrl}}/villages/{{newVillageId}}/images/0
Authorization: Bearer {{officerToken}}

### -------------------------------------------------------- ATTRACTIONS

### List attractions for a village (public)
GET {{baseUrl}}/villages/{{villageId}}/attractions

### Filter attractions by category
GET {{baseUrl}}/villages/{{villageId}}/attractions?category=nature

### Categories (to grab a categoryId)
# @name categories
GET {{baseUrl}}/categories

###
@categoryId = {{categories.response.body.data.0._id}}

### Create attraction (owning officer)
# @name createAttraction
POST {{baseUrl}}/villages/{{newVillageId}}/attractions
Authorization: Bearer {{officerToken}}
Content-Type: application/json

{ "name": "Test Viewpoint", "categoryId": "{{categoryId}}", "description": "A scenic test viewpoint." }

###
@attractionId = {{createAttraction.response.body.data._id}}

### Update attraction
PATCH {{baseUrl}}/attractions/{{attractionId}}
Authorization: Bearer {{officerToken}}
Content-Type: application/json

{ "name": "Renamed Viewpoint" }

### Delete attraction
DELETE {{baseUrl}}/attractions/{{attractionId}}
Authorization: Bearer {{officerToken}}

### -------------------------------------------------------------- EVENTS

### Global events, upcoming only
GET {{baseUrl}}/events?upcoming=true

### Events filtered by region
GET {{baseUrl}}/events?region=Abruzzo

### Events for a village
GET {{baseUrl}}/villages/{{villageId}}/events

### Create event (owning officer)
# @name createEvent
POST {{baseUrl}}/villages/{{newVillageId}}/events
Authorization: Bearer {{officerToken}}
Content-Type: application/json

{ "title": "Test Summer Fair", "description": "A test event.", "startDate": "2026-08-01", "endDate": "2026-08-03" }

###
@eventId = {{createEvent.response.body.data._id}}

### Update event
PATCH {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{officerToken}}
Content-Type: application/json

{ "title": "Test Summer Fair (updated)" }

### Delete event
DELETE {{baseUrl}}/events/{{eventId}}
Authorization: Bearer {{officerToken}}

### ------------------------------------------------------------ COMMENTS

### List approved comments for a village (public, paginated)
GET {{baseUrl}}/villages/{{villageId}}/comments?page=1&limit=10

### Post a comment (tourist) — one per user per village
# @name createComment
POST {{baseUrl}}/villages/{{newVillageId}}/comments
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "content": "Lovely little test village, worth the detour!", "rating": 5 }

###
@commentId = {{createComment.response.body.data._id}}

### Edit own comment (within 24h)
PATCH {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "rating": 4, "content": "Edited: still a lovely test village." }

### Admin moderation queue
GET {{baseUrl}}/comments/pending
Authorization: Bearer {{adminToken}}

### Moderate a comment (admin) — triggers rating recalculation
PATCH {{baseUrl}}/comments/{{commentId}}/moderate
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "approved" }

### Delete a comment (author or admin)
DELETE {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{touristToken}}

### --------------------------------------------- MY SPACE (tourist, own data)

### My own reviews (paginated, village populated)
GET {{baseUrl}}/comments/me
Authorization: Bearer {{touristToken}}

### My personal aggregate stats
GET {{baseUrl}}/me/stats
Authorization: Bearer {{touristToken}}

### List my declared visits
GET {{baseUrl}}/me/visited
Authorization: Bearer {{touristToken}}

### Declare a visit (self-reported; visitedAt optional, note optional)
# @name addVisit
POST {{baseUrl}}/me/visited
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "villageId": "{{villageId}}", "visitedAt": "2026-05-01", "note": "Beautiful stone lanes." }

###
@visitId = {{addVisit.response.body.data._id}}

### Edit my visit (date or note)
PATCH {{baseUrl}}/me/visited/{{visitId}}
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "note": "Updated note after a second trip." }

### Remove my visit
DELETE {{baseUrl}}/me/visited/{{visitId}}
Authorization: Bearer {{touristToken}}

### List my favourites
GET {{baseUrl}}/me/favorites
Authorization: Bearer {{touristToken}}

### Save a favourite
# @name addFav
POST {{baseUrl}}/me/favorites
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "villageId": "{{villageId}}" }

###
@favId = {{addFav.response.body.data._id}}

### Remove a favourite
DELETE {{baseUrl}}/me/favorites/{{favId}}
Authorization: Bearer {{touristToken}}

### ------------------------------------------------ ROUTE PLANNING (public)

### Geocode a start town
GET {{baseUrl}}/routes/geocode?q=Aosta

### Plan a route (start → village), with elevation, advisories and platform data
# @name plan
POST {{baseUrl}}/routes/plan
Content-Type: application/json

{ "start": { "lat": 45.7372, "lng": 7.3206 }, "villageId": "{{villageId}}", "profile": "driving-car", "date": "2026-08-15" }

### Corridor POIs (paste a simplified "lng,lat;lng,lat" geometry from the plan)
GET {{baseUrl}}/routes/corridor?geometry=16.045,40.5286;16.05,40.52;16.0642,40.5108&types=fuel,supermarket,viewpoint,historic

### Save a planned route (tourist)
POST {{baseUrl}}/me/routes
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "villageId": "{{villageId}}", "startLabel": "Aosta", "startLocation": { "lat": 45.7372, "lng": 7.3206 }, "profile": "driving-car", "distance": 39854, "duration": 2460 }

### List my saved routes
GET {{baseUrl}}/me/routes
Authorization: Bearer {{touristToken}}

### ------------------------------------------------------ MUNICIPALITIES

### List
# @name municipalities
GET {{baseUrl}}/municipalities

###
@municipalityId = {{municipalities.response.body.data.0._id}}

### Detail (with villages)
GET {{baseUrl}}/municipalities/{{municipalityId}}

### Create (admin)
# @name createMunicipality
POST {{baseUrl}}/municipalities
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "Comune di Test", "region": "Piedmont", "province": "Cuneo", "contactEmail": "info@test.it" }

###
@createdMunicipalityId = {{createMunicipality.response.body.data._id}}

### Update (admin)
PATCH {{baseUrl}}/municipalities/{{createdMunicipalityId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "phone": "+39 0171 000000" }

### Delete (admin) — 409 if it still has villages
DELETE {{baseUrl}}/municipalities/{{createdMunicipalityId}}
Authorization: Bearer {{adminToken}}

### -------------------------------------------------------- CATEGORIES

### List
GET {{baseUrl}}/categories

### Create (admin)
# @name createCategory
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "Test Category", "icon": "Star" }

###
@createdCategoryId = {{createCategory.response.body.data._id}}

### Update (admin)
PATCH {{baseUrl}}/categories/{{createdCategoryId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "icon": "Sparkles" }

### Delete (admin) — 409 if attractions reference it
DELETE {{baseUrl}}/categories/{{createdCategoryId}}
Authorization: Bearer {{adminToken}}

### ------------------------------------------------------------- USERS

### List users (admin), filter by role/status
GET {{baseUrl}}/users?role=officer&status=active
Authorization: Bearer {{adminToken}}

### Get one user (admin) — grab an id from the list above
# @name usersList
GET {{baseUrl}}/users?role=tourist
Authorization: Bearer {{adminToken}}

###
@someUserId = {{usersList.response.body.data.0._id}}

### Get user by id
GET {{baseUrl}}/users/{{someUserId}}
Authorization: Bearer {{adminToken}}

### Change user status (admin)
PATCH {{baseUrl}}/users/{{someUserId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "active" }

### Change user role (admin)
PATCH {{baseUrl}}/users/{{someUserId}}/role
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "role": "tourist" }

### Public officer account request (creates a pending officer + a request record)
# @name officerRequest
POST {{baseUrl}}/users/officer-request
Content-Type: application/json

{
  "firstName": "Aspiring",
  "lastName": "Officer",
  "email": "aspiring.officer@example.com",
  "password": "{{password}}",
  "municipalityName": "Comune di Testville",
  "region": "Piedmont",
  "province": "Cuneo",
  "message": "I manage tourism for our village and would like access."
}

### Delete a user (admin)
# DELETE {{baseUrl}}/users/{{someUserId}}
# Authorization: Bearer {{adminToken}}

### ------------------------------------------------- OFFICER REQUESTS

### List officer requests (admin), optional ?status=pending|approved|rejected
# @name officerRequests
GET {{baseUrl}}/officer-requests?status=pending
Authorization: Bearer {{adminToken}}

###
@officerRequestId = {{officerRequest.response.body.data.request._id}}

### Approve an officer request (admin) — activates the linked officer account
PATCH {{baseUrl}}/officer-requests/{{officerRequestId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "approved" }

### Reject an officer request (admin) — suspends the linked officer account
# PATCH {{baseUrl}}/officer-requests/{{officerRequestId}}
# Authorization: Bearer {{adminToken}}
# Content-Type: application/json
#
# { "status": "rejected" }

### -------------------------------------------------------------- STATS

### Overview (authority or admin)
GET {{baseUrl}}/stats/overview
Authorization: Bearer {{authorityToken}}

### Per-region aggregates
GET {{baseUrl}}/stats/regions
Authorization: Bearer {{authorityToken}}

### Top villages (min 3 ratings), optional ?region=
GET {{baseUrl}}/stats/villages/top
Authorization: Bearer {{authorityToken}}

### Satisfaction distribution + monthly series
GET {{baseUrl}}/stats/satisfaction
Authorization: Bearer {{authorityToken}}

### ------------------------------------------------- NEGATIVE / EDGE CASES

### Tourist cannot create a village (403)
POST {{baseUrl}}/villages
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "name": "Nope", "description": "x", "region": "r", "province": "p", "location": { "lat": 1, "lng": 1 } }

### Validation error (422, field-keyed)
POST {{baseUrl}}/villages
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "" }

### ----------------------------------------------------------------------
### Support — public submission, admin triage
### ----------------------------------------------------------------------

### Send a support message (public; no auth needed)
# @name supportMessage
POST {{baseUrl}}/support
Content-Type: application/json

{ "email": "visitor@example.com",
  "message": "The altitude shown for one of the villages looks wrong." }

@supportId = {{supportMessage.response.body.data._id}}

### Same, while signed in — the message is attributed to the account
POST {{baseUrl}}/support
Authorization: Bearer {{touristToken}}
Content-Type: application/json

{ "email": "sara@example.com", "message": "Sent while authenticated." }

### Validation: empty message (422)
POST {{baseUrl}}/support
Content-Type: application/json

{ "email": "visitor@example.com", "message": "" }

### Inbox without a token (401)
GET {{baseUrl}}/support

### Inbox as a tourist (403 — admin only)
GET {{baseUrl}}/support
Authorization: Bearer {{touristToken}}

### Inbox as admin — newest first, paginated
GET {{baseUrl}}/support
Authorization: Bearer {{adminToken}}

### Inbox filtered to unhandled messages
GET {{baseUrl}}/support?status=new
Authorization: Bearer {{adminToken}}

### Mark handled (stamps handledBy / handledAt)
PATCH {{baseUrl}}/support/{{supportId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "handled" }

### Reopen it
PATCH {{baseUrl}}/support/{{supportId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "status": "new" }

### Delete it
DELETE {{baseUrl}}/support/{{supportId}}
Authorization: Bearer {{adminToken}}

### ----------------------------------------------------------------------

### Grab a municipality id and the shuttle service type for the block below
# @name municipalitiesList
GET {{baseUrl}}/municipalities

###
@municipalityId = {{municipalitiesList.response.body.data.0._id}}

# The shuttle type is the first of the mobility group in the seeded taxonomy.
# @name shuttleLookup
GET {{baseUrl}}/service-types

###
@shuttleTypeId = {{shuttleLookup.response.body.data.0._id}}

### ----------------------------------------------------------------------
### Inter-municipal coordination
### Officers of the Valtournenche/Ayas cluster are the ones with neighbours.
### ----------------------------------------------------------------------

# @name loginTorgnon
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "officer.torgnon@mountainable.it", "password": "{{password}}" }

###
# @name loginValtournenche
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "officer.valtournenche@mountainable.it", "password": "{{password}}" }

###
@torgnonToken = {{loginTorgnon.response.body.data.token}}
@valtournencheToken = {{loginValtournenche.response.body.data.token}}

### Service taxonomy (public)
# @name serviceTypes
GET {{baseUrl}}/service-types

###
@serviceTypeId = {{serviceTypes.response.body.data.0._id}}

### Taxonomy including retired types (admin view uses this)
GET {{baseUrl}}/service-types?includeInactive=true

### Create a service type (admin)
POST {{baseUrl}}/service-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "Test service", "group": "facilities", "description": "Created by the test file.", "icon": "Tent" }

### Delete a service type that is in use (expect 409 — retire it instead)
DELETE {{baseUrl}}/service-types/{{serviceTypeId}}
Authorization: Bearer {{adminToken}}

### --- Declared capabilities -------------------------------------------------

### The whole directory (public — you do not need an account to browse it)
GET {{baseUrl}}/capabilities

### One municipality's declarations
GET {{baseUrl}}/capabilities?municipalityId={{municipalityId}}

### My own municipality's declarations (officer)
GET {{baseUrl}}/capabilities/mine
Authorization: Bearer {{torgnonToken}}

### Declare a service (municipalityId comes from the token, never the body)
# @name declareCapability
POST {{baseUrl}}/capabilities
Authorization: Bearer {{torgnonToken}}
Content-Type: application/json

{ "serviceTypeId": "{{serviceTypeId}}",
  "description": "Declared from the API test file.",
  "contactName": "Ufficio Tecnico" }

###
@capabilityId = {{declareCapability.response.body.data._id}}

### Amend it
PATCH {{baseUrl}}/capabilities/{{capabilityId}}
Authorization: Bearer {{torgnonToken}}
Content-Type: application/json

{ "description": "Amended from the API test file." }

### Confirm it is still true (refreshes the stale flag)
POST {{baseUrl}}/capabilities/{{capabilityId}}/confirm
Authorization: Bearer {{torgnonToken}}

### Another municipality tries to amend it (expect 403 — ownsCapability)
PATCH {{baseUrl}}/capabilities/{{capabilityId}}
Authorization: Bearer {{valtournencheToken}}
Content-Type: application/json

{ "description": "Should be refused." }

### Withdraw it
DELETE {{baseUrl}}/capabilities/{{capabilityId}}
Authorization: Bearer {{torgnonToken}}

### --- Candidate selection ---------------------------------------------------

### Who would receive a request? (one OSRM table call, ranked by travel time)
# @name candidates
GET {{baseUrl}}/coordination/candidates?radiusKm=60
Authorization: Bearer {{torgnonToken}}

### Narrowed to a service — only municipalities that declared it
GET {{baseUrl}}/coordination/candidates?radiusKm=60&serviceTypeId={{shuttleTypeId}}
Authorization: Bearer {{torgnonToken}}

### A radius that matches nobody — `nearest` is returned as suggestions only
GET {{baseUrl}}/coordination/candidates?radiusKm=1
Authorization: Bearer {{torgnonToken}}

### --- Requests ---------------------------------------------------------------

### Raise a request (recipients are resolved server-side and frozen)
# @name createRequest
POST {{baseUrl}}/coordination/requests
Authorization: Bearer {{torgnonToken}}
Content-Type: application/json

{ "serviceTypeId": "{{shuttleTypeId}}",
  "title": "Transport for a visiting group",
  "details": "Raised from the API test file.",
  "peopleCount": 30,
  "radiusKm": 60 }

###
@requestId = {{createRequest.response.body.data._id}}

### Our outgoing requests
GET {{baseUrl}}/coordination/requests?box=outgoing
Authorization: Bearer {{torgnonToken}}

### Requests addressed to us
GET {{baseUrl}}/coordination/requests?box=incoming
Authorization: Bearer {{valtournencheToken}}

### Detail with responses
GET {{baseUrl}}/coordination/requests/{{requestId}}
Authorization: Bearer {{torgnonToken}}

### Sidebar badge counts
GET {{baseUrl}}/coordination/inbox
Authorization: Bearer {{valtournencheToken}}

### A recipient offers
POST {{baseUrl}}/coordination/requests/{{requestId}}/responses
Authorization: Bearer {{valtournencheToken}}
Content-Type: application/json

{ "type": "offer",
  "message": "Both minibuses are free that morning.",
  "contactName": "Ufficio Tecnico", "contactPhone": "+39 0166 92101" }

### A partial offer is a first-class answer, not a variant of yes
POST {{baseUrl}}/coordination/requests/{{requestId}}/responses
Authorization: Bearer {{valtournencheToken}}
Content-Type: application/json

{ "type": "partial", "message": "Only one vehicle, and only on the Saturday." }

### The requester tries to respond to their own request (expect 403)
POST {{baseUrl}}/coordination/requests/{{requestId}}/responses
Authorization: Bearer {{torgnonToken}}
Content-Type: application/json

{ "type": "offer" }

### A municipality that was not a recipient responds (expect 403)
POST {{baseUrl}}/coordination/requests/{{requestId}}/responses
Authorization: Bearer {{officerToken}}
Content-Type: application/json

{ "type": "offer" }

### A recipient tries to close someone else's request (expect 403 — ownsRequest)
PATCH {{baseUrl}}/coordination/requests/{{requestId}}
Authorization: Bearer {{valtournencheToken}}
Content-Type: application/json

{ "status": "fulfilled" }

### Naming a municipality that was not a recipient (expect 422)
PATCH {{baseUrl}}/coordination/requests/{{requestId}}
Authorization: Bearer {{torgnonToken}}
Content-Type: application/json

{ "status": "fulfilled", "fulfilledByMunicipalityId": "000000000000000000000000" }

### Asserting `expired` as a client (expect 422 — it is a system transition)
PATCH {{baseUrl}}/coordination/requests/{{requestId}}
Authorization: Bearer {{torgnonToken}}
Content-Type: application/json

{ "status": "expired" }

### The requester records the outcome
PATCH {{baseUrl}}/coordination/requests/{{requestId}}
Authorization: Bearer {{torgnonToken}}
Content-Type: application/json

{ "status": "fulfilled", "closedNote": "Arranged directly with their technical office." }

### Responding to a closed request (expect 409)
POST {{baseUrl}}/coordination/requests/{{requestId}}/responses
Authorization: Bearer {{valtournencheToken}}
Content-Type: application/json

{ "type": "offer" }

### --- Coordination statistics (authority / admin) ----------------------------

### KPI cards
GET {{baseUrl}}/coordination/stats/overview
Authorization: Bearer {{authorityToken}}

### Capability coverage: service type x region
GET {{baseUrl}}/coordination/stats/coverage
Authorization: Bearer {{authorityToken}}

### What was sought, and whether it was met
GET {{baseUrl}}/coordination/stats/demand
Authorization: Bearer {{authorityToken}}

### Demand against declared supply — the investment-priority list
GET {{baseUrl}}/coordination/stats/gaps
Authorization: Bearer {{authorityToken}}

### Response behaviour: no capacity, or no participation?
GET {{baseUrl}}/coordination/stats/engagement
Authorization: Bearer {{authorityToken}}

### Municipalities coordination cannot help
GET {{baseUrl}}/coordination/stats/isolation?thresholdKm=60
Authorization: Bearer {{authorityToken}}

### An officer reading the territorial statistics (expect 403)
GET {{baseUrl}}/coordination/stats/demand
Authorization: Bearer {{torgnonToken}}

### Unknown route (404)
GET {{baseUrl}}/this-route-does-not-exist

### Clean up the village created above (admin, cascade)
DELETE {{baseUrl}}/villages/{{newVillageId}}
Authorization: Bearer {{adminToken}}
