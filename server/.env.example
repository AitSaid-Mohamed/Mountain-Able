# ---------------------------------------------------------------------------
# Mountain-Able API — environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# HTTP port the Express server listens on
PORT=5000

# Runtime environment: development | production | test
NODE_ENV=development

# MongoDB connection string (local instance by default)
MONGODB_URI=mongodb://127.0.0.1:27017/mountain_able

# --- Authentication -------------------------------------------------------
# Secret used to sign JWT access tokens. Use a long, random string in prod.
JWT_SECRET=change-me-to-a-long-random-secret-string
# Access-token lifetime (zeit/ms format, e.g. 15m, 2h, 7d)
JWT_EXPIRES_IN=7d

# --- Password used by the seed script for every generated account ---------
# Documented in the README; for local development only.
SEED_PASSWORD=Password123!

# --- CORS -----------------------------------------------------------------
# Origin allowed to call the API (the Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# --- File uploads ---------------------------------------------------------
# Folder (relative to the server root) where multer stores uploaded images
UPLOAD_DIR=uploads
