# ---------------------------------------------------------------------------
# Mountain-Able API — environment configuration
#
# Copy this file to `.env` for local development. `.env` is git-ignored and
# must never be committed.
#
# On Render, set these as environment variables in the service dashboard
# instead — do not upload a `.env` file. Variables marked REQUIRED IN
# PRODUCTION have no safe default and the server will either refuse to start or
# silently misbehave without them; see docs/deployment.md.
# ---------------------------------------------------------------------------

# HTTP port the Express server listens on.
# Render injects its own PORT and the server reads it; leave this alone locally.
PORT=5000

# Runtime environment: development | production | test
# Set to `production` on Render. This is not cosmetic — it switches on the
# general rate limiter, enforces the JWT_SECRET check below, and hides stack
# traces from error responses.
NODE_ENV=development

# --- Database -------------------------------------------------------------
# MongoDB connection string. Local instance by default.
#
# REQUIRED IN PRODUCTION. For Atlas, take the "Connect → Drivers" string and
# append the database name before the query string, e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mountain_able?retryWrites=true&w=majority
# Without the database name Atlas connects to `test` and the app appears empty.
# A password containing @ : / ? # [ ] must be percent-encoded.
MONGODB_URI=mongodb://127.0.0.1:27017/mountain_able

# --- Authentication -------------------------------------------------------
# Secret used to sign JWT access tokens.
#
# REQUIRED IN PRODUCTION, minimum 16 characters — the server throws on startup
# without it rather than signing tokens with a guessable default. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every existing session.
JWT_SECRET=change-me-to-a-long-random-secret-string

# Access-token lifetime (zeit/ms format, e.g. 15m, 2h, 7d)
JWT_EXPIRES_IN=7d

# --- Seeding --------------------------------------------------------------
# Password given to every account the seed script creates.
# Change this before seeding a publicly reachable database: the default is
# documented in the README and in the demo script, so it is effectively public.
SEED_PASSWORD=Password123!

# --- CORS -----------------------------------------------------------------
# Browser origins allowed to call the API, as a COMMA-SEPARATED list.
#
# REQUIRED IN PRODUCTION: the deployed frontend cannot call the API unless its
# origin appears here. Bare origins only — scheme + host (+ port), no trailing
# slash and no path. Example for a deployed site that is also developed locally:
#   CLIENT_ORIGIN=https://mountain-able.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# --- File uploads ---------------------------------------------------------
# Folder (relative to the server root) where multer stages uploaded images.
UPLOAD_DIR=uploads

# Cloudinary connection string. Optional locally, STRONGLY RECOMMENDED in
# production.
#
# Render's filesystem is ephemeral: it is wiped on every restart and every
# redeploy, so images uploaded through the village editor disappear and leave
# broken links behind. When this is set, uploads go to Cloudinary and the
# returned HTTPS URL is stored instead of a local path. When it is unset the
# server logs a warning at startup in production and falls back to local disk.
#
# Copy the value verbatim from the Cloudinary dashboard ("API Environment
# variable"); it already contains the key and secret:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=
